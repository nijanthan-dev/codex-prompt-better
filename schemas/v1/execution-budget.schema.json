{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-better.local/schemas/v1/execution-budget.schema.json",
  "title": "ExecutionBudget v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enforcement",
    "active_phases",
    "delegation_policy",
    "exhaustion_outcome"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "enforcement": {
      "enum": [
        "host_enforced",
        "advisory",
        "unknown"
      ]
    },
    "max_useful_tool_loops": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000
    },
    "max_retries": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "max_retrieval_expansions": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "active_phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "research",
          "design",
          "implementation",
          "review",
          "external_coordination"
        ]
      }
    },
    "delegation_policy": {
      "enum": [
        "none",
        "user_requested_only",
        "bounded"
      ]
    },
    "max_agent_depth": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 16
    },
    "max_concurrency": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 64
    },
    "context_mode": {
      "enum": [
        "none",
        "minimal",
        "selected",
        "full",
        "unknown"
      ]
    },
    "exhaustion_outcome": {
      "enum": [
        "stop",
        "fallback",
        "abstain",
        "approval_required"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "delegation_policy": {
            "const": "bounded"
          }
        }
      },
      "then": {
        "required": [
          "max_agent_depth",
          "max_concurrency"
        ],
        "properties": {
          "max_agent_depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          },
          "max_concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delegation_policy": {
            "enum": [
              "none",
              "user_requested_only"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "max_agent_depth": {
            "type": "null"
          },
          "max_concurrency": {
            "type": "null"
          }
        }
      }
    }
  ]
}
