{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-better.local/schemas/v1/tools/audit_session.schema.json",
  "title": "audit_session v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "../common.schema.json#/$defs/error"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "reference",
        "consent",
        "configured_sources"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "request"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "consent": {
          "enum": [
            "granted",
            "denied",
            "unknown"
          ]
        },
        "configured_sources": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "coverage",
        "evidence_refs",
        "findings",
        "redaction_applied"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "result"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "missing",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "redaction_applied": {
          "type": "boolean"
        }
      }
    }
  }
}
