{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-better.local/schemas/v1/tools/create_review_fix_prompt.schema.json",
  "title": "create_review_fix_prompt v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "../common.schema.json#/$defs/error"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "findings",
        "review_head"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "request"
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "review_head": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "fix_prompt",
        "failure_classes",
        "same_pattern_scan_required"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "result"
        },
        "fix_prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "failure_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "same_pattern_scan_required": {
          "const": true
        }
      }
    }
  }
}
